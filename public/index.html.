<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Destiny Investment Corporation System</title>
    <!-- Load Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Use Inter font for a professional look -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc; /* Light gray background */
        }
        /* Custom styles for the chart container placeholder */
        .chart-container {
            height: 300px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #fff;
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
    <div id="root" class="min-h-screen p-4 sm:p-8">
        <!-- Initial Loading State -->
        <div class="flex items-center justify-center min-h-screen">
            <div class="text-xl font-semibold text-gray-700 p-8 rounded-xl bg-white shadow-lg">
                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-blue-600 inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Initializing Destiny System...
            </div>
        </div>
    </div>

    <!-- Firebase SDK Imports (must be type="module") -->
    <script type="module">
        // Import necessary Firebase modules
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, onSnapshot, setLogLevel, doc, query } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // --- Global Variables (Provided by Canvas) ---
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
        const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
        
        // --- Mock/Initial Data (Fallbacks in case Firebase fails or is not configured) ---
        const mockPortfolioData = [
            { name: 'Equities', value: 400000, color: '#3b82f6' },
            { name: 'Bonds', value: 250000, color: '#10b981' },
            { name: 'Real Estate', value: 150000, color: '#f59e0b' },
            { name: 'Commodities', value: 100000, color: '#ef4444' },
        ];
        const mockClients = [
            { id: 'cli_001', name: 'Alpha Solutions', aum: 150000 },
            { id: 'cli_002', name: 'Beta Innovations', aum: 75000 },
        ];
        const mockActivity = [
            { id: 1, action: 'Trade Executed', clientName: 'Alpha Solutions', details: 'Bought 1000 GOOGL shares.', timestamp: Date.now() - 60000 },
            { id: 2, action: 'Client Onboarding', clientName: 'Beta Innovations', details: 'New account activated.', timestamp: Date.now() - 120000 },
        ];

        // --- Firebase State ---
        let db;
        let auth;
        let userId = 'N/A';
        let isAuthReady = false;

        // --- Application Data State ---
        let clients = mockClients;
        let activity = mockActivity;
        let portfolioData = {
            totalAssets: 900000,
            allocation: mockPortfolioData,
        };

        function initializeFirebase() {
            if (Object.keys(firebaseConfig).length === 0) {
                console.warn("Firebase configuration is missing. Running in mock data mode only.");
                isAuthReady = true;
                renderApp();
                return;
            }

            try {
                setLogLevel('debug');
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                onAuthStateChanged(auth, async (user) => {
                    if (!user) {
                        // Attempt to sign in if no user is present
                        try {
                            if (initialAuthToken) {
                                await signInWithCustomToken(auth, initialAuthToken);
                            } else {
                                await signInAnonymously(auth);
                            }
                            userId = auth.currentUser.uid;
                        } catch (error) {
                            console.error('Initial sign-in failed, using random ID:', error);
                            userId = crypto.randomUUID();
                        }
                    } else {
                        userId = user.uid;
                    }

                    isAuthReady = true;
                    // Once authenticated/ID obtained, start data fetching and rendering
                    startDataListeners();
                });
            } catch (error) {
                console.error('Firebase initialization error:', error);
                isAuthReady = true;
                renderApp(); // Render with mock data on failure
            }
        }
        
        // Function to determine the collection path for private user data
        const getPrivateCollectionPath = (collectionName) =>
            `artifacts/${appId}/users/${userId}/${collectionName}`;

        // --- Data Fetching and Real-Time Listener Setup ---

        function startDataListeners() {
            if (!db || !userId) return;

            // 1. Clients Listener
            const clientsPath = getPrivateCollectionPath('clients');
            const clientsQuery = query(collection(db, clientsPath));
            onSnapshot(clientsQuery, (snapshot) => {
                clients = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                console.log('Clients data updated:', clients.length);
                renderApp();
            }, (error) => {
                console.error('Error fetching clients:', error);
                // Keep mockClients fallback in state
                renderApp();
            });

            // 2. Activity Listener
            const activityPath = getPrivateCollectionPath('activity');
            const activityQuery = query(collection(db, activityPath));
            onSnapshot(activityQuery, (snapshot) => {
                activity = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
                // Sort by timestamp in memory (descending)
                activity.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0));
                activity = activity.slice(0, 5); // Show top 5
                console.log('Activity data updated:', activity.length);
                renderApp();
            }, (error) => {
                console.error('Error fetching activity:', error);
                // Keep mockActivity fallback in state
                renderApp();
            });

            // 3. Portfolio Listener
            const portfolioDocRef = doc(db, getPrivateCollectionPath('portfolio'), 'main_view');
            onSnapshot(portfolioDocRef, (docSnap) => {
                if (docSnap.exists()) {
                    portfolioData = docSnap.data();
                    portfolioData.totalAssets = portfolioData.totalAssets || 0;
                    portfolioData.allocation = portfolioData.allocation || mockPortfolioData;
                    console.log('Portfolio data updated.');
                } else {
                    console.log('Portfolio document not found, using mock data.');
                }
                renderApp();
            }, (error) => {
                console.error('Error fetching portfolio:', error);
                // Keep mock data in state
                renderApp();
            });
        }


        // --- Rendering Functions (DOM Manipulation) ---

        function formatCurrency(value) {
            return `$${Number(value).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`;
        }

        function createStatCard(title, value, unit = '', color = 'text-blue-600') {
            return `
                <div class="bg-white p-6 rounded-xl shadow-md border-t-4 border-blue-500 hover:shadow-lg transition duration-300">
                    <p class="text-sm font-medium text-gray-500">${title}</p>
                    <div class="mt-1 text-3xl font-bold ${color}">
                        ${value}
                        <span class="text-xl font-normal ml-1">${unit}</span>
                    </div>
                </div>
            `;
        }

        function renderActivityList(data) {
            const listItems = data.length > 0 ? data.map((item, index) => {
                const timestampText = item.timestamp ? new Date(item.timestamp).toLocaleTimeString() : '';
                return `
                    <li key="${item.id || index}" class="p-3 bg-gray-50 rounded-lg border-l-4 border-amber-500">
                        <p class="text-sm font-medium text-gray-700">${item.action || 'Unknown Action'}</p>
                        <p class="text-xs text-gray-500 mt-0.5">
                            ${item.details || 'No details provided.'}
                            ${item.clientName ? ` - Client: ${item.clientName}` : ''}
                            ${timestampText ? ` (${timestampText})` : ''}
                        </p>
                    </li>
                `;
            }).join('') : `
                <li class="p-3 text-gray-500 italic">No recent activity recorded.</li>
            `;

            return `
                <div class="bg-white p-6 rounded-xl shadow-lg h-full">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Recent System Activity</h3>
                    <ul class="space-y-3">${listItems}</ul>
                </div>
            `;
        }

        function renderClientList(data) {
            const clientCount = data.length;
            const clientItems = data.length > 0 ? data.map((client) => `
                <div key="${client.id}" class="p-4 border border-gray-200 rounded-lg flex justify-between items-center hover:bg-gray-50 transition duration-150">
                    <div>
                        <p class="text-lg font-semibold text-blue-700">${client.name || 'Unnamed Client'}</p>
                        <p class="text-sm text-gray-500">Account ID: <span class="font-mono text-xs">${client.id}</span></p>
                    </div>
                    <div class="text-right">
                        <p class="text-base font-medium text-gray-700">
                            AUM: ${formatCurrency(client.aum || 0)}
                        </p>
                    </div>
                </div>
            `).join('') : `
                <div class="p-4 text-gray-500 italic border border-dashed rounded-lg text-center">
                    No client data retrieved.
                </div>
            `;

            return `
                <div class="lg:col-span-2 bg-white p-6 rounded-xl shadow-lg overflow-auto">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">Managed Client List (${clientCount})</h3>
                    <div class="space-y-4">${clientItems}</div>
                </div>
            `;
        }
        
        function renderPlaceholderChart(title, data) {
            const listItems = data.map(item => `
                <li class="text-sm text-gray-700">${item.name}: <span class="font-bold text-lg" style="color: ${item.color}">${formatCurrency(item.value)}</span></li>
            `).join('');

            return `
                <div class="p-6 bg-white rounded-xl shadow-lg">
                    <h3 class="text-xl font-semibold text-gray-800 mb-4">${title} (Visual Placeholder)</h3>
                    <div class="chart-container border-2 border-gray-100 p-4">
                        <ul class="space-y-2">
                            <li class="text-lg font-bold text-gray-600 mb-2">Key Allocations:</li>
                            ${listItems}
                            <li class="text-xs text-gray-400 mt-4">Actual charts would be rendered here using a library like Chart.js or D3.</li>
                        </ul>
                    </div>
                </div>
            `;
        }


        function renderApp() {
            if (!isAuthReady) return; // Wait for initial auth check

            const root = document.getElementById('root');
            const totalAssets = portfolioData.totalAssets || 0;
            const clientCount = clients.length;

            const content = `
                <div class="max-w-7xl mx-auto">
                    
                    <header class="py-6 mb-8 border-b-2 border-blue-100">
                        <div class="flex justify-between items-center flex-wrap">
                            <h1 class="text-4xl font-extrabold text-blue-800 mb-2 sm:mb-0">Destiny Investment Corporation</h1>
                            <span class="text-sm font-medium text-gray-500 bg-blue-100 px-3 py-1 rounded-full shadow-sm">
                                SYSTEM DASHBOARD
                            </span>
                        </div>
                        <p class="text-sm text-gray-500 mt-2 truncate">
                            <span class="font-medium text-gray-700">Session User ID:</span> ${userId}
                        </p>
                    </header>

                    <!-- Key Metrics -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        ${createStatCard("Total Assets Under Management (AUM)", formatCurrency(totalAssets), "", "text-blue-600")}
                        ${createStatCard("Active Client Accounts", clientCount.toLocaleString(), "clients", "text-green-600")}
                        ${createStatCard("Avg. Quarterly Return (Q4 Mock)", "+5.10", "%", "text-red-600")}
                    </div>

                    <!-- Charts and Visualizations -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                        ${renderPlaceholderChart("Asset Allocation", portfolioData.allocation)}
                        ${renderPlaceholderChart("Quarterly Performance", [{ name: 'Q4 Return', value: 51000, color: '#3b82f6' }])}
                    </div>

                    <!-- Client List and Recent Activity -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        ${renderClientList(clients)}
                        ${renderActivityList(activity)}
                    </div>
                    
                </div>
            `;

            root.innerHTML = content;
        }

        // Start the application flow
        window.onload = initializeFirebase;

    </script>
</body>
</html>
